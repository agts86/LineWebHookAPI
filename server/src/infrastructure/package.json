{
	"name": "@api/infrastructure",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
		"lint": "eslint src test --ext .ts --max-warnings 0"
	},
	"dependencies": {
		"@api/tables": "workspace:*",
		"@api/shared": "workspace:*",
		"@api/features-auth": "workspace:*",
		"@api/features-managed": "workspace:*",
		"@api/features-webhook": "workspace:*",
		"@prisma/client": "^6.1.0",
		"@line/bot-sdk": "^11.2.0",
		"cheerio": "^1.0.0",
		"domhandler": "^5.0.3",
		"@nestjs/common": "^12.0.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"typescript": "^6.0.0",
		"@types/node": "^22.10.0",
		"vitest": "^3.0.0",
		"@nestjs/core": "^12.0.4",
		"@nestjs/testing": "^12.0.4",
		"@swc/core": "^1.16.2",
		"unplugin-swc": "^1.6.0"
	}
}
