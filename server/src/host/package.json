{
	"name": "@api/host",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "node --watch --conditions=development --inspect --env-file=.env --import @swc-node/register/esm-register src/main.ts",
		"start": "node dist/main.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
		"lint": "eslint src test --ext .ts --max-warnings 0"
	},
	"dependencies": {
		"@api/features-auth": "workspace:*",
		"@api/features-managed": "workspace:*",
		"@api/features-webhook": "workspace:*",
		"@api/infrastructure": "workspace:*",
		"@api/shared": "workspace:*",
		"@nestjs/common": "^12.0.4",
		"@nestjs/core": "^12.0.4",
		"@nestjs/platform-express": "^12.0.4",
		"@nestjs/swagger": "^12.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^3.24.0",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@api/tables": "workspace:*",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.2",
		"@types/node": "^22.10.0",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"typescript": "^6.0.0",
		"unplugin-swc": "^1.6.0",
		"vitest": "^3.0.0"
	}
}
