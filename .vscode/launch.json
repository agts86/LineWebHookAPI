{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "web: Next.js dev",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "prepare-web-next-cache",
            "program": "${workspaceFolder}/web/node_modules/next/dist/bin/next",
            "args": ["dev"],
            "cwd": "${workspaceFolder}/web",
            "runtimeExecutable": "node",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "- Local:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "server: host dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--watch",
                "--conditions=development",
                "--import",
                "@swc-node/register/esm-register"
            ],
            "program": "${workspaceFolder}/server/src/host/src/main.ts",
            "cwd": "${workspaceFolder}/server/src/host",
            "envFile": "${workspaceFolder}/server/src/host/.env",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "listening on\\s+(https?://\\S+)",
                "uriFormat": "%s/ui"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "compounds": [
        {
            "name": "web + server: 同時起動",
            "configurations": [
                "server: host dev",
                "web: Next.js dev"
            ]
        }
    ]
}
