{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/coverage",
			"!**/TestResults",
			"!.claude",
			"!.vscode",
			"!.mcp.json",
			"!**/pnpm-lock.yaml",
			"!**/*.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"javascript": {
		"parser": {
			// NestJSのコンストラクタ引数デコレータ(@Inject等)を解析できるようにする
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
